# Server-only OpenAI credential. Never prefix this variable with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Override without changing domain logic. The default is a current GPT model
# with structured-output support and a lower cost than the flagship model.
OPENAI_MODEL_ID=gpt-5.4-mini

# Public Supabase browser configuration. These values identify the project and
# are safe for client use; never expose SUPABASE_SECRET_KEY or service-role keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only Supabase Send SMS hook and DevSMS credentials.
# Never prefix these values with NEXT_PUBLIC_.
SUPABASE_SEND_SMS_HOOK_SECRET=
DEVSMS_API_TOKEN=
DEVSMS_API_URL=https://devsms.uz/api/send_sms.php
DEVSMS_SERVICE_NAME=UzOS
