# Server-only OpenAI credential. Never prefix this variable with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Override without changing domain logic. The default is a current GPT model
# with structured-output support and a lower cost than the flagship model.
OPENAI_MODEL_ID=gpt-5.4-mini

# Server-only FastAPI base URL. The chat proxy forwards the verified Supabase
# access token and request ID to this grounded evidence API.
GROUNDED_API_BASE_URL=http://localhost:8000/api/v1

# Public canonical origin used by metadata, sitemaps, and LLM-readable links.
NEXT_PUBLIC_SITE_URL=https://www.uzbekistanos.com

# Public Supabase browser configuration. These values identify the project and
# are safe for client use; never expose SUPABASE_SECRET_KEY or service-role keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Public Cloudflare Turnstile site key. Keep the Turnstile secret in Supabase
# Auth configuration only; it must never be added to the application or Git.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only credential used for authenticated self-service account exports
# and deletion. Prefer the current Supabase secret key; the application also
# accepts SUPABASE_SERVICE_ROLE_KEY during migration from legacy keys.
SUPABASE_SECRET_KEY=

# Server-only Supabase Send SMS hook and DevSMS credentials.
# Never prefix these values with NEXT_PUBLIC_.
SUPABASE_SEND_SMS_HOOK_SECRET=
DEVSMS_API_TOKEN=
DEVSMS_API_URL=https://devsms.uz/api/send_sms.php
DEVSMS_SERVICE_NAME=UzOS
