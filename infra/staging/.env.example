POSTGRES_DB=uzbekistan_os
POSTGRES_USER=uzbekistan_os
POSTGRES_PASSWORD=replace-with-a-long-random-value
DATABASE_URL=postgresql+psycopg://uzbekistan_os:replace-with-a-url-encoded-password@postgres:5432/uzbekistan_os

S3_ACCESS_KEY=replace-with-a-unique-staging-access-key
S3_SECRET_KEY=replace-with-a-long-random-value
S3_BUCKET=uzbekistan-os-ingestion
S3_REGION=us-east-1

API_CORS_ORIGINS=https://staging.example.com
API_ALLOWED_HOSTS=staging.example.com,*.vercel.app
LOG_LEVEL=INFO
STAGING_BIND_ADDRESS=127.0.0.1
STAGING_API_PORT=8000
STAGING_WEB_PORT=3000
WORKER_SCHEDULER_POLL_SECONDS=60
WORKER_REGISTRY_PATH=data/sources/registry.staging.json

# Enable only for a controlled staging evaluation after credentials and reviewed
# Uzbek publications are present.
AI_GENERATION_ENABLED=false
AI_PROMPT_REGISTRY_PATH=data/prompts/registry.v1.json
AI_MODEL_ROUTE_REGISTRY_PATH=data/models/registry.mvp.json
AI_RETRIEVAL_LIMIT=8
AI_EVIDENCE_MAX_ITEMS=6
AI_EVIDENCE_MAX_CHARACTERS=9000
AI_CONVERSATION_RECENT_TURNS=8
AI_CONVERSATION_SUMMARY_TRIGGER_TURNS=12
AI_CONVERSATION_SUMMARY_MAX_CHARACTERS=4000
AI_CONVERSATION_CONTEXT_MAX_CHARACTERS=16000
AI_STREAM_START_TARGET_MS=2000
AI_FIRST_CONTENT_TARGET_MS=3000
AI_RESPONSE_TARGET_MS=8000
AI_CITATION_COVERAGE_TARGET=0.95
OPENAI_API_KEY=
OPENAI_GENERATION_MODEL=gpt-5.4-mini
OPENAI_STORE_RESPONSES=false
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-key
