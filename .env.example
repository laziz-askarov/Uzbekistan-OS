APP_ENV=development
APP_NAME=Uzbekistan OS API
APP_VERSION=0.1.0
LOG_LEVEL=INFO
READINESS_TIMEOUT_SECONDS=2
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000

POSTGRES_DB=uzbekistan_os
POSTGRES_USER=uzbekistan_os
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql+psycopg://uzbekistan_os:local-development-only@localhost:5432/uzbekistan_os
REDIS_URL=redis://localhost:6379/0
WORKER_STREAM=uzbekistan-os:ingestion
WORKER_GROUP=ingestion-workers
WORKER_CONSUMER_NAME=
WORKER_DEAD_LETTER_STREAM=uzbekistan-os:ingestion:dead
WORKER_RETRY_SET=uzbekistan-os:ingestion:retries
WORKER_BLOCK_MS=5000
WORKER_STALE_AFTER_MS=120000
WORKER_RETRY_BASE_SECONDS=30
WORKER_RETRY_MAX_SECONDS=900
WORKER_SCHEDULER_POLL_SECONDS=60
WORKER_REGISTRY_PATH=data/sources/registry.development.json
INGESTION_MAX_PDF_PAGES=250
INGESTION_MAX_NORMALIZED_CHARACTERS=2000000
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=uzbekistan-os
S3_SECRET_KEY=local-development-only
S3_BUCKET=uzbekistan-os-ingestion
S3_REGION=us-east-1
S3_AUTO_CREATE_BUCKET=true

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_STORE_RESPONSES=false

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
