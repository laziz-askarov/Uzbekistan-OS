APP_ENV=development
APP_NAME=Uzbekistan OS API
APP_VERSION=0.1.0
LOG_LEVEL=INFO
READINESS_TIMEOUT_SECONDS=2
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000
API_ALLOWED_HOSTS=localhost,127.0.0.1,testserver,*.vercel.app

POSTGRES_DB=uzbekistan_os
POSTGRES_USER=uzbekistan_os
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql+psycopg://uzbekistan_os:local-development-only@localhost:5432/uzbekistan_os
REDIS_URL=redis://localhost:6379/0
WORKER_STREAM=uzbekistan-os:ingestion
WORKER_GROUP=ingestion-workers
WORKER_CONSUMER_NAME=
WORKER_DEAD_LETTER_STREAM=uzbekistan-os:ingestion:dead
WORKER_RETRY_SET=uzbekistan-os:ingestion:retries
WORKER_BLOCK_MS=5000
WORKER_STALE_AFTER_MS=120000
WORKER_RETRY_BASE_SECONDS=30
WORKER_RETRY_MAX_SECONDS=900
WORKER_SCHEDULER_POLL_SECONDS=60
WORKER_REGISTRY_PATH=data/sources/registry.development.json
AI_GENERATION_ENABLED=false
AI_PROMPT_REGISTRY_PATH=data/prompts/registry.v1.json
AI_MODEL_ROUTE_REGISTRY_PATH=data/models/registry.mvp.json
AI_RETRIEVAL_LIMIT=8
AI_EVIDENCE_MAX_ITEMS=6
AI_EVIDENCE_MAX_CHARACTERS=9000
AI_CONVERSATION_RECENT_TURNS=8
AI_CONVERSATION_SUMMARY_TRIGGER_TURNS=12
AI_CONVERSATION_SUMMARY_MAX_CHARACTERS=4000
AI_CONVERSATION_CONTEXT_MAX_CHARACTERS=16000
AI_STREAM_START_TARGET_MS=2000
AI_FIRST_CONTENT_TARGET_MS=3000
AI_RESPONSE_TARGET_MS=8000
AI_CITATION_COVERAGE_TARGET=0.95
INGESTION_MAX_PDF_PAGES=250
INGESTION_MAX_NORMALIZED_CHARACTERS=2000000
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=uzbekistan-os
S3_SECRET_KEY=local-development-only
S3_BUCKET=uzbekistan-os-ingestion
S3_REGION=us-east-1
S3_AUTO_CREATE_BUCKET=true

OPENAI_API_KEY=
OPENAI_GENERATION_MODEL=gpt-5.4-mini
OPENAI_STORE_RESPONSES=false

# API-side customer token verification. The publishable key is not a secret;
# never place a Supabase secret or service-role key in these fields.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-key

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
GROUNDED_API_BASE_URL=http://localhost:8000/api/v1
