{
  "name": "uzbekistan-os",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm --filter @uzbekistan-os/web build",
    "dev": "pnpm --filter @uzbekistan-os/web dev",
    "format:check": "prettier --check \"apps/web/**/*.{ts,tsx,css,mjs,json}\" \"packages/design-system/**/*.{ts,tsx,css,json,md}\" package.json pnpm-workspace.yaml docker-compose.yml \".github/**/*.yml\"",
    "lint": "pnpm --filter @uzbekistan-os/web lint",
    "typecheck": "pnpm --filter @uzbekistan-os/web typecheck"
  },
  "devDependencies": {
    "prettier": "3.9.6"
  }
}
