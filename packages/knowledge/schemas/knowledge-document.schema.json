{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uzbekistan-os.local/schemas/knowledge-document.schema.json",
  "title": "Knowledge document",
  "type": "object",
  "required": [
    "id",
    "slug",
    "domain",
    "language",
    "status",
    "version",
    "title",
    "summary",
    "sections",
    "sources",
    "effective_from",
    "reviewed_at"
  ],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "domain": {
      "type": "string",
      "enum": [
        "immigration",
        "tourism",
        "business-registration",
        "healthcare",
        "everyday-living"
      ]
    },
    "language": { "type": "string", "enum": ["en", "uz", "ru"] },
    "status": {
      "type": "string",
      "enum": ["draft", "in_review", "published", "expired", "archived"]
    },
    "version": {
      "type": "object",
      "required": ["major", "minor", "revision"],
      "properties": {
        "major": { "type": "integer", "minimum": 1 },
        "minor": { "type": "integer", "minimum": 0 },
        "revision": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "audiences": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "keywords": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "entities": {
      "type": "array",
      "items": { "$ref": "#/$defs/entity" },
      "uniqueItems": true
    },
    "applicability": { "$ref": "#/$defs/applicability" },
    "requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/requirement" }
    },
    "steps": {
      "type": "array",
      "items": { "$ref": "#/$defs/step" }
    },
    "fees": {
      "type": "array",
      "items": { "$ref": "#/$defs/fee" }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/section" }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "effective_from": { "type": "string", "format": "date" },
    "effective_until": { "type": ["string", "null"], "format": "date" },
    "reviewed_at": { "type": "string", "format": "date-time" },
    "translation_of": {
      "type": ["string", "null"],
      "format": "uuid",
      "deprecated": true
    },
    "translation": { "$ref": "#/$defs/translation" },
    "domain_data": { "type": ["object", "null"] }
  },
  "$defs": {
    "entity": {
      "type": "object",
      "required": ["id", "type", "name"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "type": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "applicability": {
      "type": "object",
      "properties": {
        "audiences": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "nationalities": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Z]{2}$" },
          "uniqueItems": true
        },
        "residency_statuses": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "locations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "conditions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "requirement": {
      "type": "object",
      "required": ["id", "title", "description", "mandatory", "citations"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "mandatory": { "type": "boolean" },
        "applies_when": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "citations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/citation" }
        }
      },
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "required": ["id", "ordinal", "title", "description", "citations"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "ordinal": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "requirement_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true
        },
        "citations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/citation" }
        }
      },
      "additionalProperties": false
    },
    "fee": {
      "type": "object",
      "required": ["id", "label", "amount_type", "citations"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "label": { "type": "string", "minLength": 1 },
        "amount_type": {
          "type": "string",
          "enum": ["exact", "range", "variable", "unknown"]
        },
        "amount": { "type": ["number", "null"], "minimum": 0 },
        "minimum_amount": { "type": ["number", "null"], "minimum": 0 },
        "maximum_amount": { "type": ["number", "null"], "minimum": 0 },
        "currency": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" },
        "conditions": { "type": ["string", "null"] },
        "citations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/citation" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "amount_type": { "const": "exact" } },
            "required": ["amount_type"]
          },
          "then": { "required": ["amount", "currency"] }
        },
        {
          "if": {
            "properties": { "amount_type": { "const": "range" } },
            "required": ["amount_type"]
          },
          "then": {
            "required": ["minimum_amount", "maximum_amount", "currency"]
          }
        }
      ],
      "additionalProperties": false
    },
    "translation": {
      "type": "object",
      "required": ["status", "canonical_language"],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "original",
            "human_reviewed",
            "machine_assisted_reviewed",
            "pending_review"
          ]
        },
        "canonical_language": { "type": "string", "enum": ["en", "uz", "ru"] },
        "source_document_id": { "type": ["string", "null"], "format": "uuid" },
        "reviewed_at": { "type": ["string", "null"], "format": "date-time" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": ["human_reviewed", "machine_assisted_reviewed"]
              }
            },
            "required": ["status"]
          },
          "then": { "required": ["reviewed_at"] }
        }
      ],
      "additionalProperties": false
    },
    "citation": {
      "type": "object",
      "required": ["source_id", "locator"],
      "properties": {
        "source_id": { "type": "string", "format": "uuid" },
        "locator": { "type": "string", "minLength": 1 },
        "quote": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "section": {
      "type": "object",
      "required": ["id", "heading", "body", "citations"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "heading": { "type": "string", "minLength": 1 },
        "body": { "type": "string", "minLength": 1 },
        "citations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/citation" }
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "organization",
        "title",
        "url",
        "retrieved_at",
        "snapshot_sha256"
      ],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "organization": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "retrieved_at": { "type": "string", "format": "date-time" },
        "snapshot_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
