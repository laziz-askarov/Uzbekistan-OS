{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uzbekistan-os.local/schemas/tourism-document.schema.json",
  "title": "Tourism knowledge document",
  "allOf": [
    {
      "$ref": "https://uzbekistan-os.local/schemas/knowledge-document.schema.json"
    },
    {
      "type": "object",
      "required": ["domain_data"],
      "properties": {
        "domain": { "const": "tourism" },
        "domain_data": {
          "type": "object",
          "required": ["topic"],
          "properties": {
            "topic": { "type": "string", "minLength": 1 },
            "traveler_categories": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "visit_purposes": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
